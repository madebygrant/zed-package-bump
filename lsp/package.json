{
  "name": "package-bump-lsp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --outfile=../server/server.js",
    "watch": "esbuild src/server.ts --bundle --platform=node --format=cjs --outfile=../server/server.js --watch",
    "type-check": "tsc --noEmit"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
